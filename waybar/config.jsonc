{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 8,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "network",
        "battery",
        "tray"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": ""
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "hyprland/window": {
        "max-length": 50
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "cpu": {
        "format": " CPU {usage}%"
    },

    "memory": {
        "format": " RAM {}%"
    },

    "pulseaudio": {
        "format": " {volume}%"
    },

    "network": {
        "format-wifi": " {essid}",
        "format-disconnected": " Offline"
    },

    "battery": {
        "format": " {capacity}%"
    },

    "tray": {
        "spacing": 8
    }
}
